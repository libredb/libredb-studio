-- The keyspaces, tables, code and roles every later capture reads, created as the image's default superuser.
CREATE KEYSPACE probe WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};
CREATE KEYSPACE other WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};
CREATE KEYSPACE "MixedCase" WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};
CREATE TABLE probe.customers (id int PRIMARY KEY, name text, email text);
CREATE TABLE probe.orders (id int PRIMARY KEY, customer_id int, amount int);
CREATE TABLE probe.masked (id int PRIMARY KEY, plain text, builtin_masked text MASKED WITH mask_default(), udf_masked text);
CREATE TABLE other.t (id int PRIMARY KEY, v text);
CREATE TABLE "MixedCase"."Things" (id int PRIMARY KEY);
INSERT INTO probe.customers (id, name, email) VALUES (1, 'Ada', 'ada@example.test');
INSERT INTO probe.customers (id, name, email) VALUES (2, 'Brian', 'brian@example.test');
INSERT INTO probe.orders (id, customer_id, amount) VALUES (10, 1, 5);
INSERT INTO probe.masked (id, plain, builtin_masked, udf_masked) VALUES (1, 'visible', 'hidden-by-builtin', 'hidden-by-udf');
INSERT INTO other.t (id, v) VALUES (1, 'before');
CREATE FUNCTION probe.plus_one(x int) RETURNS NULL ON NULL INPUT RETURNS int LANGUAGE java AS 'return x + 1;';
CREATE FUNCTION probe.acc(state int, v int) CALLED ON NULL INPUT RETURNS int LANGUAGE java AS 'return state + (v == null ? 0 : v);';
CREATE AGGREGATE probe.total(int) SFUNC acc STYPE int INITCOND 0;
CREATE FUNCTION probe.redact(v text) RETURNS NULL ON NULL INPUT RETURNS text LANGUAGE java AS 'return "redacted-by-udf";';
CREATE FUNCTION probe.js_one(x int) RETURNS NULL ON NULL INPUT RETURNS int LANGUAGE javascript AS 'x + 1';
ALTER TABLE probe.masked ALTER udf_masked MASKED WITH probe.redact();
CREATE MATERIALIZED VIEW probe.orders_by_customer AS SELECT * FROM probe.orders WHERE customer_id IS NOT NULL AND id IS NOT NULL PRIMARY KEY (customer_id, id);
CREATE ROLE agent_ro WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON KEYSPACE probe TO agent_ro;
CREATE ROLE agent_table WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON TABLE probe.customers TO agent_table;
CREATE ROLE agent_modify WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON KEYSPACE probe TO agent_modify;
GRANT MODIFY ON KEYSPACE other TO agent_modify;
CREATE ROLE agent_super WITH LOGIN = true AND SUPERUSER = true AND PASSWORD = 'not-a-real-password';
CREATE ROLE agent_allks WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON ALL KEYSPACES TO agent_allks;
CREATE ROLE agent_exec WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON KEYSPACE probe TO agent_exec;
GRANT EXECUTE ON FUNCTION probe.plus_one(int) TO agent_exec;
CREATE ROLE agent_unmask WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON KEYSPACE probe TO agent_unmask;
GRANT UNMASK ON KEYSPACE probe TO agent_unmask;
CREATE ROLE writer_inner;
GRANT MODIFY ON KEYSPACE probe TO writer_inner;
CREATE ROLE writer_middle;
GRANT writer_inner TO writer_middle;
CREATE ROLE agent_inherit WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON KEYSPACE probe TO agent_inherit;
GRANT writer_middle TO agent_inherit;
CREATE ROLE super_inner WITH SUPERUSER = true;
CREATE ROLE agent_inherit_super WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON KEYSPACE probe TO agent_inherit_super;
GRANT super_inner TO agent_inherit_super;
CREATE ROLE agent_mixed WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON KEYSPACE "MixedCase" TO agent_mixed;
GRANT SELECT ON TABLE "MixedCase"."Things" TO agent_mixed;
CREATE ROLE agent_none WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
CREATE ROLE agent_describe WITH LOGIN = true AND PASSWORD = 'not-a-real-password';
GRANT SELECT ON KEYSPACE probe TO agent_describe;
GRANT DESCRIBE ON ALL ROLES TO agent_describe;

-- Every write the agent role is refused, the code a SELECT can reach, and the one write the server lets it make.
INSERT INTO probe.customers (id, name) VALUES (99, 'x');
UPDATE probe.customers SET name = 'x' WHERE id = 1;
DELETE FROM probe.customers WHERE id = 1;
INSERT INTO probe.customers (id, name) VALUES (98, 'x') IF NOT EXISTS;
BEGIN BATCH INSERT INTO probe.customers (id, name) VALUES (97, 'x'); APPLY BATCH;
BEGIN UNLOGGED BATCH UPDATE probe.orders SET amount = 0 WHERE id = 10; APPLY BATCH;
TRUNCATE probe.customers;
CREATE TABLE probe.created (id int PRIMARY KEY);
CREATE TABLE IF NOT EXISTS probe.created (id int PRIMARY KEY);
DROP TABLE probe.orders;
DROP TABLE IF EXISTS probe.libredb_agent_probe;
ALTER TABLE probe.customers ADD extra text;
CREATE INDEX ON probe.customers (name);
CREATE MATERIALIZED VIEW probe.mv2 AS SELECT * FROM probe.customers WHERE id IS NOT NULL AND name IS NOT NULL PRIMARY KEY (name, id);
CREATE FUNCTION probe.f2(x int) RETURNS NULL ON NULL INPUT RETURNS int LANGUAGE java AS 'return x;';
CREATE TYPE probe.addr (street text);
ALTER KEYSPACE probe WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};
CREATE KEYSPACE made WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};
GRANT SELECT ON KEYSPACE other TO agent_ro;
GRANT MODIFY ON KEYSPACE probe TO agent_ro;
REVOKE SELECT ON KEYSPACE probe FROM agent_ro;
CREATE ROLE made_role;
ALTER ROLE agent_ro WITH SUPERUSER = true;
ALTER ROLE agent_ro WITH LOGIN = false;
ALTER ROLE agent_ro WITH OPTIONS = {'k': 'v'};
ALTER ROLE agent_ro WITH PASSWORD = 'not-a-real-password';
INSERT INTO other.t (id, v) VALUES (2, 'x');
SELECT * FROM other.t;
SELECT plus_one(id) FROM probe.customers WHERE id = 1;
SELECT probe.plus_one(id) FROM probe.customers WHERE id = 1;
SELECT total(amount) FROM probe.orders;
SELECT id, plain, builtin_masked, udf_masked FROM probe.masked;
SELECT id, plain FROM probe.masked;
SELECT * FROM probe.orders_by_customer;
SELECT toJson(name), now(), writetime(name), token(id) FROM probe.customers WHERE id = 1;
SELECT name, value FROM system_views.settings WHERE name = 'authorizer';
UPDATE system_views.settings SET value = 'false' WHERE name = 'materialized_views_enabled';
USE other;
SELECT * FROM t;

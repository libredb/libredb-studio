 {
  "sleep": 3000
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE PRIMARY INDEX ON `probe`"
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE PRIMARY INDEX ON `other`"
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE SCOPE `probe`.`s1`"
  }
 },
 {
  "sleep": 2000
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE COLLECTION `probe`.`s1`.`c1`"
  }
 },
 {
  "sleep": 2000
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE PRIMARY INDEX ON `probe`.`s1`.`c1`"
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "UPSERT INTO `probe` (KEY, VALUE) VALUES (\"d1\", {\"n\": 1, \"note\": \"first\"}), (\"d2\", {\"n\": 2, \"note\": \"second\"})"
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "UPSERT INTO `other` (KEY, VALUE) VALUES (\"o1\", {\"n\": 10, \"note\": \"other bucket\"})"
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "UPSERT INTO `probe`.`s1`.`c1` (KEY, VALUE) VALUES (\"c1\", {\"n\": 100})"
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE OR REPLACE FUNCTION `probe`.`_default`.f_inline(x) { x + 1 }"
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE OR REPLACE FUNCTION g_inline(x) { x * 2 }"
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE OR REPLACE FUNCTION `probe`.`_default`.f_js(x) LANGUAGE JAVASCRIPT AS \"function f_js(x) { return x + 1; }\""
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE OR REPLACE FUNCTION `probe`.`_default`.f_jsw() LANGUAGE JAVASCRIPT AS \"function f_jsw() { var r = INSERT INTO `_default` (KEY, VALUE) VALUES ('w-js', {'by': 'js'}); r.close(); return 'wrote'; }\""
  }
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "CREATE SEQUENCE `probe`.`_default`.seq1"
  }
 },
 {
  "sleep": 2000
 },
 {
  "as": "Administrator",
  "query": {
   "statement": "SELECT META(d).id, d.* FROM default:`probe` AS d ORDER BY META(d).id",
   "scan_consistency": "request_plus"
  }
 }
]
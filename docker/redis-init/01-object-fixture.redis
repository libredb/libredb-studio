DEL user:1 user:2 user:3 session:abc session:def queue:jobs standalone
SET user:1 alice
SET user:2 bob
SET user:3 carol
HSET session:abc user 1 ip 10.0.0.1
HSET session:def user 2 ip 10.0.0.2

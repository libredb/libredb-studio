#!/bin/bash
# Generates this instance's credentials. Nothing else - no docker, no systemctl.
# Runs only while /etc/libredb-studio.env is absent (unit condition).
set -euo pipefail

JWT_SECRET="$(openssl rand -base64 48 | tr -d '\n')"
# Hex, not base64: the value goes into a docker --env-file, which has no quoting
# or escaping rules at all.
ADMIN_PASSWORD="$(openssl rand -hex 16)"
[ -n "$JWT_SECRET" ] && [ -n "$ADMIN_PASSWORD" ] || { echo "FATAL: secret generation failed" >&2; exit 1; }

( umask 077
  {
    # Strict mode: nothing is generated by the app itself, everything explicit.
    printf 'AUTH_BOOTSTRAP=off\n'
    printf 'NEXT_PUBLIC_AUTH_PROVIDER=local\n'
    printf 'JWT_SECRET=%s\n' "$JWT_SECRET"
    printf 'ADMIN_EMAIL=admin@libredb.org\n'
    printf 'ADMIN_PASSWORD=%s\n' "$ADMIN_PASSWORD"
    printf 'STORAGE_PROVIDER=sqlite\n'
    printf 'STORAGE_SQLITE_PATH=/app/data/libredb-storage.db\n'
    printf 'PORT=3000\n'
    printf 'HOSTNAME=0.0.0.0\n'
    # Plain HTTP deployment: without this the Secure cookie is discarded by the
    # browser and login loops silently while every health probe still passes.
    printf 'AUTH_COOKIE_SECURE=false\n'
    # Deliberately no LLM_ variables: AI assistance ships unconfigured, which is
    # also what keeps the listing clear of the "ongoing external connection"
    # policy - the endpoint is whatever the buyer points LLM_API_URL at.
  } > /etc/libredb-studio.env.tmp
)
chmod 600 /etc/libredb-studio.env.tmp
# Atomic, and last: the env file's existence is this unit's only state. Writing
# it first and failing later would leave the condition satisfied, the unit
# skipped on every later boot, and the buyer with neither a password nor an
# error.
mv /etc/libredb-studio.env.tmp /etc/libredb-studio.env

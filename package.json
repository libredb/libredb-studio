    "happy-dom": "^20.11.6",
    "knip": "^6.32.2",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "workflow": "4.8.1"
  }
}

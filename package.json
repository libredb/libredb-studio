    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.8.2",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",

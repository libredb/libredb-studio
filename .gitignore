# Playwright run artifacts
/test-results/
/playwright-report/

npmjs-token

.npmrc

.token
.sonar-token
data/
# e2e/offline-editor.spec.ts's isolated server (playwright.config.ts) gets its own data dir so it
# never contends for the primary server's exclusive-lock sample files.
data-e2e-offline/
# Local Docker test volumes and any stray embedded-db files
.docker-data*/
# The agent runtime's durable ledger: with WORKFLOW_LOCAL_DATA_DIR unset it resolves
# against the working directory, so running an agent locally writes run ledgers here.
.workflow-data/
*.libredb

docs/superpowers/

# attw packaging scratch (type-resolution check)
.attw/
*.tgz

# Snap build scratch (payload staged for snap/snapcraft.yaml) and outputs
snap-payload/
*.snap

# Desktop shell (issue #232): Rust build output plus the payload and Node sidecar
# staged into the Tauri project by scripts/build-desktop-appimage.sh
desktop/src-tauri/target/
desktop/src-tauri/payload/
desktop/src-tauri/bin/
# Capability/permission schemas regenerated by tauri-build on every build
desktop/src-tauri/gen/schemas/
*.AppImage
*.AppImage.sha256
# Desktop GUI Debian package (issue #241) and the default local output dir.
# Narrow patterns: the headless server package is libredb-studio_<version>_*.deb
# and is produced by a different job, but neither belongs in the repo either.
libredb-studio-desktop_*.deb
libredb-studio-desktop_*.deb.sha256
/dist-desktop/
# scripts/build-flatpark-local.sh working directory
/build/

# deploy test results
deploy/rancher/results/

.cursor/plans/
.cursor/specs/
.cursor/rules/
docs/summaries/

# Maintainer loop runtime artifacts (not source)
.loop/
.tokens

# DO marketplace scripts fetched at build time (see deploy/digitalocean/README.md)
deploy/digitalocean/droplet/scripts/90-cleanup.sh
deploy/digitalocean/droplet/scripts/99-img-check.sh

# Local output if you add report/output flags to the security scanner commands
# yourself - the copy-paste commands in CONTRIBUTING.md print to stdout and
# write nothing by default. CI writes its reports to RUNNER_TEMP.
/gitleaks-report.json
/trivy-report.json
/trivy-report.sarif
/*.cdx.json




# local gate-4 probe harness (issue #424), never committed
/probe-424.ts
/probe-results/

{
  "$schema": "urn:libredb:provider-manifest:0.1",
  "contract": "0.1",
  "runtime": {
    "entry": "dist/provider.mjs",
    "env": [
      {
        "name": "KAFKA_CLIENT_ID",
        "purpose": "The client id the provider names itself by to every broker."
      }
    ]
  },
  "calls": {
    "console": {
      "execute": {
        "honours": []
      },
      "cancel": "not-offered",
      "endScope": "not-offered"
    }
  },
  "engines": [
    {
      "id": "kafka",
      "displayName": "Apache Kafka",
      "location": "external",
      "connection": {
        "fields": ["host", "port", "user", "password", "saslMechanism", "connectionString"],
        "defaults": {
          "port": 9092
        },
        "seedOnly": null,
        "refused": [],
        "connectionString": {
          "accepted": true,
          "dialogOffersUri": true,
          "scheme": null,
          "urlTls": null,
          "paste": null,
          "seedCheck": null
        },
        "tls": "offered",
        "sshTunnel": {
          "offered": false,
          "refusal": "Kafka does not run through an SSH tunnel: a client reaches every broker the cluster names. Turn the tunnel off."
        },
        "hostPathFields": [],
        "opensLocalFile": false,
        "serverLevelWithoutDatabase": false,
        "agentCredential": {
          "form": "pair",
          "supersededBy": []
        },
        "dialog": {
          "order": null,
          "labels": [{ "field": "user", "text": "SASL user" }],
          "hints": [{ "field": "host", "text": "A bootstrap broker: the client learns every other broker from it." }],
          "placeholders": [],
          "placement": [],
          "options": [
            {
              "field": "saslMechanism",
              "choices": [
                { "value": "PLAIN", "label": "PLAIN" },
                { "value": "SCRAM-SHA-256", "label": "SCRAM-SHA-256" },
                { "value": "SCRAM-SHA-512", "label": "SCRAM-SHA-512" }
              ]
            }
          ],
          "shownWhen": [],
          "absentValues": []
        },
        "hostUriSchemes": [],
        "credentialWarnings": [],
        "fieldRules": [],
        "hostHint": null,
        "hostIdentity": null,
        "import": null
      },
      "facets": {
        "monitoring": {
          "overview": "offered",
          "performance": "not-offered",
          "slowQueries": "not-offered",
          "activeSessions": "not-offered",
          "tables": "offered",
          "indexes": "not-offered",
          "storage": "offered"
        },
        "maintenance": [],
        "agentReadings": ["table-stats", "storage"]
      },
      "agent": {
        "statementLanguage": "kafkaread"
      },
      "editor": {
        "commitKeyword": "COMMIT",
        "consentDeadline": null,
        "fenceAliases": ["kafkaread"],
        "explainFormat": null,
        "dialect": {
          "name": "kafka",
          "offersColumnProfiling": false,
          "offersCodeGeneration": false,
          "offersCountQuery": false,
          "offersSqlExport": true,
          "historyMask": null
        }
      },
      "sqlText": {
        "readsSqlText": false,
        "grammar": {
          "hash": "comment-unless-operator",
          "bracket": "quoted-identifier",
          "blockComment": "flat",
          "alternateQuoting": false,
          "doubleSlashComment": false,
          "backslashAlwaysEscapes": false,
          "tripleQuotedStrings": false,
          "backtickBackslashEscapes": false,
          "dollarTags": true,
          "doubleQuoteBackslashEscapes": null,
          "singleQuoteBackslashEscapes": null,
          "rawStrings": false,
          "hintsAreCode": false,
          "lineCommentBackslashContinues": false,
          "lineCommentEndsAtCarriageReturn": false,
          "script": {
            "blocks": "none",
            "separatorLine": null,
            "unit": "statement",
            "terminatedStatements": []
          },
          "trailingLimitClauses": [
            {
              "source": "\\s+ALLOW\\s+FILTERING\\s*$",
              "flags": "i"
            }
          ],
          "nonNumericRowBounds": [],
          "confirmForms": [],
          "confirmCodeForms": [],
          "confirmFormsWhen": [],
          "confirmExemptForms": [],
          "formatterLanguage": "postgresql",
          "completionWords": {
            "keywords": [],
            "functions": []
          },
          "confirmConfigKeys": null,
          "explainExecutesWithAnalyze": false
        },
        "redaction": {
          "kind": "command",
          "reader": "redactionReader"
        },
        "updateTarget": {
          "dashCommentNeedsSeparator": false,
          "extraQueryOpeners": [],
          "extraSetOperators": []
        },
        "completion": {
          "formatSegment": "formatSegment",
          "readQuotedQualifier": "readQuotedQualifier"
        }
      }
    }
  ],
  "compatibility": [
    {
      "engine": "kafka",
      "product": "Apache Kafka",
      "versions": {
        "kind": "range",
        "from": "3.7.0",
        "to": "4.1.0"
      },
      "tested": [
        {
          "version": "3.7.0",
          "image": {
            "repository": "docker.io/apache/kafka",
            "digest": "sha256:0d3b6e3f2c1a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f9012345678"
          }
        },
        {
          "version": "4.1.0",
          "image": {
            "repository": "docker.io/apache/kafka",
            "digest": "sha256:9a8b7c6d5e4f30211f0e9d8c7b6a5948372615a4b3c2d1e0f9e8d7c6b5a49382"
          }
        }
      ]
    },
    {
      "engine": "kafka",
      "product": "Redpanda",
      "versions": {
        "kind": "service",
        "measured": "2026-11-20"
      },
      "tested": [
        {
          "version": "cloud"
        }
      ]
    }
  ],
  "vendor": {
    "notes": "Any shape the package wants."
  }
}

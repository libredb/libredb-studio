#!/bin/sh
# ==============================================================================
# Launcher installed by the libredb-studio .deb/.rpm packages (issue #112).
#
# Execs the bundled private Node runtime against the standalone server
# payload under /usr/lib/libredb-studio. All configuration comes from the
# environment: under systemd that is the unit's Environment= lines plus
# /etc/libredb-studio/env; when run directly, whatever the shell provides
# (zero-config first run generates missing auth secrets and prints the
# admin password once).
#
# server.js chdirs to the payload directory itself, so relative defaults
# (e.g. STORAGE_SQLITE_PATH=./data/...) resolve inside the payload - the
# systemd unit always sets an absolute STORAGE_SQLITE_PATH under
# /var/lib/libredb-studio instead.
# ==============================================================================
set -eu

LIBREDB_STUDIO_HOME=/usr/lib/libredb-studio

exec "$LIBREDB_STUDIO_HOME/node/bin/node" "$LIBREDB_STUDIO_HOME/server.js" "$@"

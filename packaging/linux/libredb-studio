#!/bin/sh
# ==============================================================================
# Launcher installed by the libredb-studio .deb/.rpm packages (issue #112).
#
# Execs the bundled private Node runtime against the standalone server
# payload under /usr/lib/libredb-studio. All configuration comes from the
# environment: under systemd that is the unit's Environment= lines plus
# /etc/libredb-studio/env; when run directly, whatever the shell provides
# (zero-config first run generates missing auth secrets and prints the
# admin password once).
#
# server.js chdirs to the payload directory itself, so relative defaults
# (e.g. STORAGE_SQLITE_PATH=./data/...) would resolve inside the read-only,
# root-owned /usr/lib/libredb-studio and the first-run bootstrap could not
# persist its generated credentials. The systemd unit sets an absolute
# STORAGE_SQLITE_PATH under /var/lib/libredb-studio; for direct runs the
# fallback below keeps state in a user-writable XDG state directory.
# ==============================================================================
set -eu

LIBREDB_STUDIO_HOME="${LIBREDB_STUDIO_HOME:-/usr/lib/libredb-studio}"

# Local-first bind (issue #134): a direct run must not leak whatever HOSTNAME
# the calling shell happens to have - Docker exports HOSTNAME=<container-id>
# to every process, which Next.js would then bind to instead of loopback (a
# plain "is it unset" check misses this, since the inherited value is
# non-empty). Systemd already resolves HOSTNAME correctly before this script
# execs, via the unit's Environment=/EnvironmentFile= (libredb-studio.service
# plus /etc/libredb-studio/env); INVOCATION_ID is set for every systemd unit
# process since systemd 232, so that path is left untouched. Direct runs
# default to loopback unless LIBREDB_BIND opts in to a different address.
if [ -z "${INVOCATION_ID:-}" ]; then
  HOSTNAME="${LIBREDB_BIND:-127.0.0.1}"
  export HOSTNAME
fi

if [ -z "${STORAGE_SQLITE_PATH:-}" ]; then
  STORAGE_SQLITE_PATH="${XDG_STATE_HOME:-${HOME:-/root}/.local/state}/libredb-studio/libredb-storage.db"
  export STORAGE_SQLITE_PATH
fi

exec "$LIBREDB_STUDIO_HOME/node/bin/node" "$LIBREDB_STUDIO_HOME/server.js" "$@"

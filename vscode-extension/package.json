{
  "name": "libredb-studio",
  "publisher": "libredb",
  "displayName": "LibreDB Studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/libredb/libredb-studio",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.sql"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "libredb.showLog",
        "title": "Show Log",
        "category": "LibreDB"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "c8 mocha",
    "coverage:check": "node ../scripts/check-coverage.mjs coverage/lcov.info",
    "test:integration": "mocha --config test/integration/.mocharc.json --require test/setup/register.cjs",
    "test:e2e": "node esbuild.mjs --e2e-tests && vscode-test",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.120.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "c8": "11.0.0",
    "esbuild": "0.28.2",
    "mocha": "11.8.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yauzl": "3.4.0"
  }
}

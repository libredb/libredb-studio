{
  "name": "libredb-studio",
  "publisher": "libredb",
  "displayName": "LibreDB Studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/libredb/libredb-studio",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.sql"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "libredb.showLog",
        "title": "Show Log",
        "category": "LibreDB"
      },
      {
        "command": "libredb.addConnection",
        "title": "Add Connection",
        "category": "LibreDB",
        "icon": "$(add)"
      },
      {
        "command": "libredb.removeConnection",
        "title": "Remove Connection",
        "category": "LibreDB"
      },
      {
        "command": "libredb.refresh",
        "title": "Refresh",
        "category": "LibreDB",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "LibreDB",
      "properties": {
        "libredb.connections": {
          "type": "array",
          "scope": "application",
          "default": [],
          "markdownDescription": "Database connections, without passwords or connection strings: LibreDB keeps those in VS Code's secret storage on each machine. Add one with **LibreDB: Add Connection**.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "type",
              "createdAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string"
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "user": {
                "type": "string"
              },
              "database": {
                "type": "string"
              },
              "instanceName": {
                "type": "string"
              },
              "authSource": {
                "type": "string"
              },
              "ssl": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "type": "string"
                  }
                }
              },
              "createdAt": {
                "type": "string"
              },
              "secretFields": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "c8 mocha",
    "coverage:check": "node ../scripts/check-coverage.mjs coverage/lcov.info",
    "test:integration": "mocha --config test/integration/.mocharc.json --require test/setup/register.cjs",
    "test:e2e": "node esbuild.mjs --e2e-tests && vscode-test",
    "test:browser": "playwright test -c playwright.config.mjs",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.3",
    "@playwright/test": "1.64.1",
    "@sinonjs/fake-timers": "15.4.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.120.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "mocha": "12.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "//overrides": "@vscode/test-cli 0.0.15, the latest release, asks for mocha ^11.7.6, and both mocha releases in that range depend on serialize-javascript ^6.0.2 and diff ^7.0.0, which carry GHSA-5c6j-r48x-rmvq (remote code execution through RegExp.flags and Date.prototype.toISOString(), fixed in serialize-javascript 7.0.3), GHSA-qj8w-gfj5-8c6v (CPU exhaustion through crafted array-like objects, fixed in 7.0.5) and GHSA-73rr-hh4g-fpgx (a denial of service in diff's parsePatch and applyPatch, fixed in 8.0.3), with no fix inside either range. mocha 12.0.3, the direct pin, takes serialize-javascript ^7.1.1 and diff ^9.0.0, and this entry hands @vscode/test-cli that same mocha through the $mocha reference, so one copy runs the unit, integration and e2e legs and follows the pin. mocha 12 is outside test-cli's range, so it was verified where test-cli drives Mocha, inside the extension host: the e2e leg passes, full and smoke, on both builds of test/vscode-versions.json. test-cli's runner needs only new Mocha(), addFile() and run(), and its JSON stream reporter Mocha.Runner.constants, all of which mocha 12 keeps. None of these packages reaches the VSIX: .vscodeignore lets in only dist/extension.js, dist/backend.js, dist/webview/results.js, dist/webview/results.css and the package's own text files. Remove the entry once a @vscode/test-cli release asks for mocha 12: microsoft/vscode-test-cli#118 made that change on 2026-08-31 and is not released yet.",
  "overrides": {
    "@vscode/test-cli": {
      "mocha": "$mocha"
    }
  },
  "dependencies": {
    "vscode-jsonrpc": "9.0.3"
  }
}

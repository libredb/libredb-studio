{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "mocha"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*.tsx", "../src/types/db-drivers.d.ts"]
}

{
  "id": "opensearch",
  "displayName": "OpenSearch",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password"
    ],
    "defaults": {
      "port": 9200
    },
    "seedOnly": null,
    "refused": [
      {
        "field": "apiKeyId",
        "refusal": "OpenSearch does not accept API key authentication. Elasticsearch publishes Authorization: ApiKey; nothing here has measured whether OpenSearch's security plugin accepts that scheme, so the pair is refused rather than sent as Basic or as a guessed header."
      },
      {
        "field": "apiKeySecret",
        "refusal": "OpenSearch does not accept API key authentication. Elasticsearch publishes Authorization: ApiKey; nothing here has measured whether OpenSearch's security plugin accepts that scheme, so the pair is refused rather than sent as Basic or as a guessed header."
      }
    ],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [],
      "hints": [],
      "placeholders": [],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "offered",
      "indexes": "not-offered",
      "storage": "offered"
    },
    "maintenance": [],
    "agentReadings": [
      "table-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  }
}

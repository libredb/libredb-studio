{
  "id": "couchbase",
  "displayName": "Couchbase",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database",
      "connectionString"
    ],
    "defaults": {
      "port": 8091
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": true,
      "dialogOffersUri": true,
      "scheme": "couchbase",
      "urlTls": null,
      "paste": {
        "reader": "pasteReader",
        "catchAll": false,
        "formats": [
          "couchbase://"
        ]
      },
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": false,
      "refusal": "Couchbase does not run through an SSH tunnel: the tunnel forwards one port, and queries go to the query service, on another port, at the address the cluster's node map advertises. Turn the tunnel off."
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "database",
          "text": "Bucket Name"
        }
      ],
      "hints": [],
      "placeholders": [
        {
          "field": "connectionString",
          "text": "couchbase://localhost:8091/travel-sample  or  couchbases://cb.<id>.cloud.couchbase.com/..."
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "offered"
    },
    "maintenance": [
      "analyze",
      "reindex",
      "kill"
    ],
    "agentReadings": [
      "sessions",
      "slow-queries",
      "table-stats",
      "index-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  }
}

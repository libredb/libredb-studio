{
  "id": "duckdb",
  "displayName": "DuckDB",
  "location": "external",
  "connection": {
    "fields": [
      "database"
    ],
    "defaults": {},
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": false,
      "refusal": "DuckDB opens a file on the Studio server, so there is no address for an SSH tunnel to forward to. Turn the tunnel off: edit the connection and save it again."
    },
    "hostPathFields": [],
    "opensLocalFile": true,
    "serverLevelWithoutDatabase": false,
    "agentCredential": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "offered"
    },
    "maintenance": [
      "vacuum",
      "analyze",
      "optimize"
    ],
    "agentReadings": [
      "table-stats",
      "index-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  }
}

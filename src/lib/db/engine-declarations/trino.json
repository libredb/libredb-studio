{
  "id": "trino",
  "displayName": "Trino",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database",
      "schema"
    ],
    "defaults": {
      "port": 8080
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "database",
          "text": "Catalog Name"
        }
      ],
      "hints": [
        {
          "field": "password",
          "text": "Trino refuses a password over plain HTTP. Enable TLS below, or leave this empty to connect as an unauthenticated user."
        },
        {
          "field": "database",
          "text": "The Trino catalog to open, such as tpch or hive. Its schemas are the level below."
        }
      ],
      "placeholders": [
        {
          "field": "database",
          "text": "tpch"
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "not-offered",
      "storage": "offered"
    },
    "maintenance": [
      "kill"
    ],
    "agentReadings": [
      "sessions",
      "slow-queries",
      "table-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [],
    "explainFormat": "trino-json",
    "dialect": null
  },
  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "code",
      "bracket": "subscript",
      "blockComment": "flat",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [],
      "nonNumericRowBounds": [],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "sql",
      "nameQuote": null
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  },
  "sqlWriting": {
    "escapeLiteral": "escapeLiteral",
    "unescapeLiteral": "unescapeLiteral",
    "quoteIdentifier": "quoteIdentifier",
    "placeholder": null,
    "temporalLiteral": null,
    "inlineEdit": {
      "instantTypeNames": [
        "date",
        "date32",
        "datetime",
        "datetime2",
        "datetime64",
        "datetimeoffset",
        "smalldatetime",
        "timestamp",
        "timestamptz"
      ],
      "exactDecimalTypeNames": [
        "number",
        "numeric",
        "decimal",
        "dec",
        "money",
        "smallmoney"
      ],
      "float64TypeNames": [
        "double",
        "float8",
        "float64",
        "binary_double"
      ],
      "boundEdit": null
    },
    "export": {
      "ddlTypes": {
        "text": "VARCHAR",
        "integer": "BIGINT",
        "numeric": "DOUBLE PRECISION",
        "boolean": "BOOLEAN",
        "timestamp": "TIMESTAMP",
        "binary": "VARBINARY"
      },
      "standsAlone": [
        "varchar",
        "varbinary",
        "timestamp",
        "timestamp without time zone",
        "timestamp with time zone"
      ],
      "bareSpelling": [],
      "typeVocabulary": {
        "bareTypeFamily": {
          "text": [
            "character varying",
            "varchar",
            "varchar2",
            "nvarchar",
            "nvarchar2",
            "character",
            "char",
            "nchar",
            "text",
            "ntext",
            "tinytext",
            "mediumtext",
            "longtext",
            "clob",
            "nclob",
            "enum",
            "set",
            "uniqueidentifier",
            "rowid"
          ],
          "integer": [
            "year"
          ],
          "numeric": [
            "numeric",
            "decimal",
            "number",
            "binary_double",
            "binary_float",
            "money"
          ],
          "boolean": [],
          "timestamp": [
            "timestamp",
            "timestamp without time zone",
            "timestamp with time zone",
            "datetime",
            "datetime2",
            "smalldatetime",
            "datetimeoffset"
          ],
          "binary": [
            "binary",
            "varbinary",
            "raw",
            "blob",
            "tinyblob",
            "mediumblob",
            "longblob",
            "bytea",
            "image"
          ]
        },
        "floatType": {
          "source": "^(double( precision)?|real|float\\d*|binary_(double|float))$",
          "flags": "i"
        },
        "exactNumericType": {
          "source": "^(numeric|decimal|number|decfloat)(\\s*\\(\\s*\\d+\\s*(,\\s*-?\\d+\\s*)?\\))?$",
          "flags": "i"
        },
        "numericWrapper": {
          "source": "^\\s*(?:Nullable|LowCardinality)\\((.*)\\)\\s*$",
          "flags": ""
        }
      },
      "binaryLiteral": "binaryLiteral",
      "nonFinite": {
        "NaN": "NULL",
        "Infinity": "NULL",
        "-Infinity": "NULL"
      },
      "insertForm": "values",
      "rewriteDeclared": null,
      "declareFromSample": null,
      "typedLiteral": "typedLiteral",
      "columnWriters": null,
      "createTableKey": null
    },
    "insertDocuments": null
  },
  "migrationDdl": {
    "tableDdl": "written",
    "transactionWrapper": null,
    "createTable": {
      "kind": "written",
      "primaryKey": "createTablePrimaryKey",
      "foreignKey": "createTableForeignKey"
    },
    "columnDef": "columnDef",
    "createIndex": "createIndex",
    "dropIndex": "dropIndex",
    "addForeignKey": "addForeignKey",
    "dropForeignKey": "dropForeignKey",
    "addColumn": "addColumn",
    "dropColumn": "dropColumn",
    "modifyColumn": "modifyColumn",
    "dropTable": "dropTable",
    "reasons": [
      "Whether a column can be retyped is the connector's answer, not Trino's; run the change in the system the catalog points at.",
      "Trino: Cannot generate index DDL. Indexes belong to the connector's underlying system, not Trino SQL.",
      "The engine has no foreign-key constraint.",
      "Trino SQL has no primary-key constraint."
    ]
  }
}

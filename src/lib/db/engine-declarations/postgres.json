{
  "id": "postgres",
  "displayName": "PostgreSQL",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database"
    ],
    "defaults": {
      "port": 5432
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": true,
      "dialogOffersUri": false,
      "scheme": "postgres",
      "urlTls": "urlTls",
      "paste": {
        "reader": "pasteReader",
        "catchAll": false,
        "formats": [
          "postgres://"
        ]
      },
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": true,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [],
      "hints": [],
      "placeholders": [],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "offered"
    },
    "maintenance": [
      "vacuum",
      "analyze",
      "reindex",
      "kill"
    ],
    "agentReadings": [
      "sessions",
      "slow-queries",
      "table-stats",
      "index-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "postgresql",
      "pgsql",
      "psql",
      "plpgsql"
    ],
    "explainFormat": "postgres-json",
    "dialect": null
  },
  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "code",
      "bracket": "subscript",
      "blockComment": "nesting",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [
        {
          "source": "\\s+AS\\s+OF\\s+(?:AT\\s+LEAST\\s+)?(?:\\d+|'[^']*')\\s*$",
          "flags": "i"
        },
        {
          "source": "\\s+FOR\\s+(?:NO\\s+KEY\\s+UPDATE|KEY\\s+SHARE|UPDATE|SHARE)(?:\\s+OF\\s+(?:\"(?:[^\"]|\"\")*\"|[^\\s()',;\"`][^\\s()',;\"`]*)(?:\\s*,\\s*(?:\"(?:[^\"]|\"\")*\"|[^\\s()',;\"`][^\\s()',;\"`]*))*)?(?:\\s+(?:NOWAIT|SKIP\\s+LOCKED))?\\s*$",
          "flags": "i"
        }
      ],
      "nonNumericRowBounds": [
        "ALL"
      ],
      "confirmForms": [],
      "confirmCodeForms": [
        {
          "wordThenBody": "DO"
        },
        [
          "DO",
          "LANGUAGE"
        ]
      ],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": true
    },
    "redaction": {
      "kind": "sql",
      "nameQuote": "\""
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": "formatSegment",
      "readQuotedQualifier": "readQuotedQualifier"
    }
  }
}

      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [
        {
          "source": "\\s+AS\\s+OF\\s+(?:AT\\s+LEAST\\s+)?(?:\\d+|'[^']*')\\s*$",
          "flags": "i"
        },
        {
          "source": "\\s+FOR\\s+(?:NO\\s+KEY\\s+UPDATE|KEY\\s+SHARE|UPDATE|SHARE)(?:\\s+OF\\s+(?:\"(?:[^\"]|\"\")*\"|[^\\s()',;\"`][^\\s()',;\"`]*)(?:\\s*,\\s*(?:\"(?:[^\"]|\"\")*\"|[^\\s()',;\"`][^\\s()',;\"`]*))*)?(?:\\s+(?:NOWAIT|SKIP\\s+LOCKED))?\\s*$",
          "flags": "i"
        }
      ],
      "nonNumericRowBounds": [
        "ALL"
      ],
      "confirmForms": [],
      "confirmCodeForms": [
        {
          "wordThenBody": "DO"
        },
        [
          "DO",
          "LANGUAGE"
        ]
      ],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": true
    },
    "redaction": {
      "kind": "sql",
      "nameQuote": "\""

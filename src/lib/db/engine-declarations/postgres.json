  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "code",
      "bracket": "subscript",
      "blockComment": "nesting",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": false,

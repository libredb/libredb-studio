  "migrationDdl": {
    "tableDdl": "refused",
    "refusal": "-- InfluxDB 3 (SQL): Cannot generate table DDL. A table's tags and fields are created by the line protocol written to it, and InfluxDB 3's SQL takes no DDL, so there is no column definition to change.",

{
  "id": "mqtt",
  "displayName": "MQTT",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database",
      "allowInsecureAuth"
    ],
    "defaults": {
      "port": 1883
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "database",
          "text": "Topic filter"
        }
      ],
      "hints": [
        {
          "field": "host",
          "text": "A name or address only. If Studio runs in a container, localhost is that container: use host.docker.internal."
        },
        {
          "field": "user",
          "text": "A broker username, if the broker checks one; empty for a broker that does not."
        },
        {
          "field": "password",
          "text": "The password for that username. A password needs an SSL mode other than disable, unless the host is this machine or an SSH tunnel carries the connection."
        },
        {
          "field": "database",
          "text": "What to subscribe to. Empty means #, every topic except the broker's own $SYS tree, which no # filter reaches. A narrower filter reads less and finishes sooner. $share/, $queue/ and $exclusive/ are refused: each one takes messages away from the devices that need them, and no broker reports that it happened."
        },
        {
          "field": "allowInsecureAuth",
          "text": "With no SSL mode the username and password cross the network in cleartext. A password sent without TLS to a host that is not this machine is refused unless this is ticked. Choose an SSL mode under SSL / TLS instead wherever the broker offers one."
        }
      ],
      "placeholders": [
        {
          "field": "database",
          "text": "#"
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": []
  },
  "agent": {
    "statementLanguage": "mqttread"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [

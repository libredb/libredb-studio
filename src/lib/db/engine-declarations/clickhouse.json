{
  "id": "clickhouse",
  "displayName": "ClickHouse",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database",
      "connectionString"
    ],
    "defaults": {
      "port": 8123
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": true,
      "dialogOffersUri": true,
      "scheme": "clickhouse",
      "urlTls": null,
      "paste": {
        "reader": "pasteReader",
        "catchAll": true,
        "formats": [
          "clickhouse://",
          "http(s)://"
        ]
      },
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [],
      "hints": [],
      "placeholders": [
        {
          "field": "connectionString",
          "text": "mongodb://localhost:27017/mydb  or  mongodb+srv://..."
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null,
    "connectBudgetMs": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "offered"
    },
    "maintenance": [
      "optimize",
      "analyze",
      "kill"
    ],
    "agentReadings": [
      "sessions",
      "slow-queries",
      "table-stats",
      "index-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [],
    "explainFormat": "clickhouse-json",
    "dialect": null,
    "language": {
      "queryLanguage": "sql",
      "monacoId": "sql",
      "accent": "border-hue-blue/40",
      "console": false
    }
  },
  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "comment",
      "bracket": "subscript",
      "blockComment": "nesting",
      "alternateQuoting": false,
      "doubleSlashComment": true,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [],
      "nonNumericRowBounds": [],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "sql",
      "nameQuote": null
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  },
  "sqlWriting": {
    "escapeLiteral": "escapeLiteral",
    "unescapeLiteral": "unescapeLiteral",
    "quoteIdentifier": "quoteIdentifier",
    "placeholder": null,
    "temporalLiteral": null,
    "inlineEdit": {
      "instantTypeNames": [
        "date",
        "date32",
        "datetime",
        "datetime2",
        "datetime64",
        "datetimeoffset",
        "smalldatetime",
        "timestamp",
        "timestamptz"
      ],
      "exactDecimalTypeNames": [
        "number",
        "numeric",
        "decimal",
        "dec",
        "money",
        "smallmoney"
      ],
      "float64TypeNames": [
        "double",
        "float8",
        "float64",
        "binary_double"
      ],
      "boundEdit": null
    },
    "export": {
      "ddlTypes": {
        "text": "TEXT",
        "integer": "BIGINT",
        "numeric": "DOUBLE PRECISION",
        "boolean": "BOOLEAN",
        "timestamp": "TIMESTAMP",
        "binary": "String"
      },
      "standsAlone": [
        "character varying",
        "varchar",
        "varchar2",
        "nvarchar",
        "character",
        "char",
        "nchar",
        "text",
        "tinytext",
        "mediumtext",
        "longtext",
        "clob",
        "varbinary",
        "blob",
        "tinyblob",
        "mediumblob",
        "longblob",
        "bytea",
        "timestamp",
        "datetime",
        "year"
      ],
      "bareSpelling": [],
      "typeVocabulary": {
        "bareTypeFamily": {
          "text": [
            "character varying",
            "varchar",
            "varchar2",
            "nvarchar",
            "nvarchar2",
            "character",
            "char",
            "nchar",
            "text",
            "ntext",
            "tinytext",
            "mediumtext",
            "longtext",
            "clob",
            "nclob",
            "enum",
            "set",
            "uniqueidentifier",
            "rowid"
          ],
          "integer": [
            "year"
          ],
          "numeric": [
            "numeric",
            "decimal",
            "number",
            "binary_double",
            "binary_float",
            "money"
          ],
          "boolean": [],
          "timestamp": [
            "timestamp",
            "timestamp without time zone",
            "timestamp with time zone",
            "datetime",
            "datetime2",
            "smalldatetime",
            "datetimeoffset"
          ],
          "binary": [
            "binary",
            "varbinary",
            "raw",
            "blob",
            "tinyblob",
            "mediumblob",
            "longblob",
            "bytea",
            "image"
          ]
        },
        "floatType": {
          "source": "^(double( precision)?|real|float\\d*|binary_(double|float))$",
          "flags": "i"
        },
        "exactNumericType": {
          "source": "^(numeric|decimal|number|decfloat)(\\s*\\(\\s*\\d+\\s*(,\\s*-?\\d+\\s*)?\\))?$",
          "flags": "i"
        },
        "numericWrapper": {
          "source": "^\\s*(?:Nullable|LowCardinality)\\((.*)\\)\\s*$",
          "flags": ""
        }
      },
      "binaryLiteral": "binaryLiteral",
      "nonFinite": {
        "NaN": "nan",
        "Infinity": "inf",
        "-Infinity": "-inf"
      },
      "insertForm": "values",
      "rewriteDeclared": null,
      "declareFromSample": null,
      "typedLiteral": "typedLiteral",
      "columnWriters": null,
      "createTableKey": null
    },
    "insertDocuments": null

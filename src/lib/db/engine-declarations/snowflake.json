        {
          "field": "host",
          "text": "An account identifier such as myorg-myaccount, or its https:// URL."
        },
        {
          "field": "user",
          "text": "The user's login name (LOGIN_NAME)."
        },
        {
          "field": "privateKey",
          "text": "Paste the private key's contents. Studio reads no key file."
        },
        {
          "field": "privateKeyPassphrase",
          "text": "Only for an encrypted key."
        },
        {
          "field": "password",
          "text": "A programmatic access token for this user."
        },
        {
          "field": "warehouse",
          "text": "Leave empty to use the user's default warehouse. Queries need one; browsing does not."
        },
        {
          "field": "database",
          "text": "Opened first in the tree, and the default for unqualified names."
        },
        {
          "field": "schema",
          "text": "The default schema for unqualified names."
        },
        {
          "field": "role",
          "text": "Every statement runs as this role; Studio checks it when it connects."
        }
      ],

{
  "id": "kubernetes",
  "displayName": "Kubernetes",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "password",
      "database",
      "namespaces",
      "apiPath",
      "tlsServerName"
    ],
    "defaults": {
      "port": 6443
    },
    "seedOnly": null,
    "refused": [
      "user"
    ],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "secret",
      "supersededBy": []
    }
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": [
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "kubectl"
  }
}

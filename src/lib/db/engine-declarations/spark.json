  },
  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "code",
      "bracket": "subscript",
      "blockComment": "nesting",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": true,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": true,
      "hintsAreCode": true,
      "lineCommentBackslashContinues": true,
      "lineCommentEndsAtCarriageReturn": true,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [
        {
          "source": "\\s+OFFSET\\s+\\d+\\s*$",
          "flags": "i"
        }
      ],
      "nonNumericRowBounds": [],
      "confirmForms": [
        [
          "CREATE",
          "OR",
          "REPLACE"
        ],
        [
          "REPLACE",
          "TABLE"
        ],
        [
          "LOAD",
          "DATA"
        ],
        [
          "CALL"
        ],
        [
          "EXECUTE",

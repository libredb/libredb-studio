{
  "id": "spark",
  "displayName": "Apache Spark",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "password",
      "database",
      "schema"
    ],
    "defaults": {
      "port": 15002
    },
    "seedOnly": null,
    "refused": [
      {
        "field": "user",
        "refusal": "Apache Spark connections take no user: every Studio request uses one fixed Spark Connect user id, and Token is the credential. Clear User. Nothing was sent."
      }
    ],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": {
        "reader": "pasteReader",
        "catchAll": false,
        "formats": [
          "sc://"
        ]
      },
      "seedCheck": null
    },
    "tls": "offered",
    "readsTrustMaterial": false,
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": null,
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "host",
          "text": "Host"
        },
        {
          "field": "port",
          "text": "Port"
        },
        {
          "field": "password",
          "text": "Token"
        },
        {
          "field": "database",
          "text": "Catalog"
        },
        {
          "field": "schema",
          "text": "Namespace"
        }
      ],
      "hints": [
        {
          "field": "host",
          "text": "The host of the Spark Connect server, or of a TLS proxy in front of it. Spark Connect listens on 15002 unless the server was started on another port. Paste an sc:// address with Paste URL."
        },
        {
          "field": "password",
          "text": "The server's spark.connect.authenticate.token (Spark 4.0 and later), sent on every call. Leave it empty for a server without a token. Studio sends a token only over TLS or an SSH tunnel, unless the host is this machine."
        },
        {
          "field": "database",
          "text": "The catalog unqualified names resolve in, and the one the tree opens first. Empty: the server's default catalog."
        },
        {
          "field": "schema",
          "text": "The namespace in that catalog, written as in Spark SQL: parts joined by dots, a part with other characters in backticks. Empty: the catalog's current namespace."
        }
      ],
      "placeholders": [
        {
          "field": "database",
          "text": "server default (spark_catalog)"
        },
        {
          "field": "schema",
          "text": "catalog default"
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [
      {
        "field": "host",
        "required": "Host is required: the name or address of the Spark Connect server, or of the TLS proxy in front of it. Nothing was sent.",
        "format": null,
        "charRange": null,
        "check": null
      },
      {
        "field": "password",
        "required": null,
        "format": {
          "pattern": {
            "source": "^(?:[\\x21-\\x7E](?:[\\x20-\\x7E]*[\\x21-\\x7E])?)?$",
            "flags": ""
          },
          "sentence": "Token takes printable ASCII with no space at either end: a gRPC header cannot carry other characters, and Spark compares the token exactly. Nothing was sent."
        },
        "charRange": null,
        "check": null
      },
      {
        "field": "database",
        "required": null,
        "format": {
          "pattern": {
            "source": "^[^.\\p{Cc}]{1,255}$",
            "flags": "u"
          },
          "sentence": "Catalog takes one catalog name without dots, as spark.sql.catalog.<name> names it. Nothing was sent."
        },
        "charRange": null,
        "check": null
      },
      {
        "field": "schema",
        "required": null,
        "format": {
          "pattern": {
            "source": "^(?:[A-Za-z_][A-Za-z0-9_]*|`(?:[^`]|``)+`)(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|`(?:[^`]|``)+`)){0,7}$",
            "flags": ""
          },
          "sentence": "Namespace takes a Spark SQL namespace: parts joined by dots, each a letter or _ followed by letters, digits or _, or written in backticks with a backtick doubled; at most 8 parts. Nothing was sent."
        },
        "charRange": null,
        "check": null
      }
    ],
    "hostHint": null,
    "hostIdentity": null,
    "import": null,
    "connectBudgetMs": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": [
      "health"
    ]
  },
  "agent": {
    "statementLanguage": null

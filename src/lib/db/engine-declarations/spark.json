        [
          "EVOLUTION",
          "OVERWRITE"
        ],
        [
          "REPLACE",
          "WHERE"
        ],
        [
          "REPLACE",
          "ON"
        ],
        [
          "REPLACE",
          "USING"
        ],
        [
          "USING",
          "JAR"
        ],
        [
          "USING",
          "FILE"
        ],
        [
          "USING",
          "ARCHIVE"
        ],
        [
          "DROP",
          "PARTITIONS"
        ],
        [
          "SYNC",
          "PARTITIONS"
        ],
        {
          "wordThenLiteral": "USING"
        },
        [
          "REFLECT"
        ],
        [
          "JAVA_METHOD"
        ],
        [
          "TRY_REFLECT"
        ],
        {
          "quotedCall": "REFLECT"
        },
        {
          "quotedCall": "JAVA_METHOD"
        },
        {
          "quotedCall": "TRY_REFLECT"
        },
        {
          "computedCall": "IDENTIFIER"
        },
        {
          "dollarQuoted": true
        }
      ],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": [
        "spark.sql.variable.substitute",
        "spark.sql.defaultCatalog",
        "spark.sql.catalog."
      ],
      "explainExecutesWithAnalyze": false
    },
    "redaction": {

{
  "id": "spark",
  "displayName": "Apache Spark",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "password",
      "database",
      "schema"
    ],
    "defaults": {
      "port": 15002
    },
    "seedOnly": null,
    "refused": [
      "user"
    ],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": [
      "health"
    ]
  },
  "agent": {
    "statementLanguage": null
  }
}

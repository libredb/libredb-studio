{
  "id": "snmp",
  "displayName": "SNMP",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "password",
      "allowInsecureAuth"
    ],
    "defaults": {
      "port": 161
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": "not-offered",
    "sshTunnel": {
      "offered": false,
      "refusal": "SNMP does not run through an SSH tunnel: the tunnel forwards TCP, and SNMP reads travel as UDP datagrams. Turn the tunnel off."
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": null,
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "host",
          "text": "Host"
        },
        {
          "field": "password",
          "text": "Community"
        },
        {
          "field": "allowInsecureAuth",
          "text": "Send the community in clear to an agent that is not on this machine"
        }
      ],
      "hints": [
        {
          "field": "host",
          "text": "A name or address only. If Studio runs in a container, localhost is that container: use host.docker.internal."
        },
        {
          "field": "password",
          "text": "The read community. It travels in clear in every v2c datagram and there is no transport security under it, so `public` and `private` are the documented defaults every device ships with."
        },
        {
          "field": "allowInsecureAuth",
          "text": "Ticked, the community travels in clear in every datagram to an agent that is not on this machine. SNMPv2c has no authentication either: an answer can be forged by anything that can reach this connection."
        }
      ],
      "placeholders": [
        {
          "field": "password",
          "text": ""
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": [
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "snmpget"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "snmpget"
    ],
    "explainFormat": null,
    "dialect": {
      "name": "snmp",
      "offersColumnProfiling": false,
      "offersCodeGeneration": false,
      "offersCountQuery": false,
      "offersSqlExport": true,
      "historyMask": null
    }
  }
}

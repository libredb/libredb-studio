{
  "id": "libsql",
  "displayName": "libSQL",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "connectionString"
    ],
    "defaults": {
      "port": 8080
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": true,
      "dialogOffersUri": true,
      "scheme": "libsql",
      "urlTls": null,
      "paste": {
        "reader": "pasteReader",
        "catchAll": false,
        "formats": [
          "libsql://"
        ]
      },
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "secret",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "password",
          "text": "Auth Token"
        }
      ],
      "hints": [
        {
          "field": "user",
          "text": "Only for a self-hosted libSQL server started with SQLD_HTTP_AUTH, which checks a user name and password as HTTP Basic: the Auth Token box then takes the password. Leave it empty for Turso Cloud and for a server that checks tokens."
        },
        {
          "field": "password",
          "text": "Turso Cloud mints this per database (`turso db tokens create`). A self-hosted libSQL server started without authentication takes none - leave it empty."
        }
      ],
      "placeholders": [
        {
          "field": "connectionString",
          "text": "libsql://<database>-<org>.turso.io?authToken=<jwt>"
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "offered"

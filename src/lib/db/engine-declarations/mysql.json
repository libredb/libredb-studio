{
  "id": "mysql",
  "displayName": "MySQL",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database"
    ],
    "defaults": {
      "port": 3306
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": true,
      "dialogOffersUri": false,
      "scheme": "mysql",
      "urlTls": "urlTls",
      "paste": {
        "reader": "pasteReader",
        "catchAll": false,
        "formats": [
          "mysql://"
        ]
      },
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [],
      "hints": [],
      "placeholders": [],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "offered"
    },
    "maintenance": [
      "analyze",
      "optimize",
      "check",
      "kill"
    ],
    "agentReadings": [
      "sessions",
      "slow-queries",
      "table-stats",
      "index-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "mariadb"
    ],
    "explainFormat": "mysql-json",
    "dialect": null
  },
  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "comment",
      "bracket": "quoted-identifier",
      "blockComment": "flat",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [
        {
          "source": "\\s+FOR\\s+(?:UPDATE|SHARE)(?:\\s+OF\\s+(?:`(?:[^`]|``)*`|\"(?:[^\"]|\"\")*\"|[^\\s()',;\"`]+)(?:\\s*,\\s*(?:`(?:[^`]|``)*`|\"(?:[^\"]|\"\")*\"|[^\\s()',;\"`]+))*)?(?:\\s+(?:NOWAIT|SKIP\\s+LOCKED|WAIT\\s+\\d+))?\\s*$",
          "flags": "i"
        },
        {
          "source": "\\s+LOCK\\s+IN\\s+SHARE\\s+MODE(?:\\s+(?:NOWAIT|SKIP\\s+LOCKED|WAIT\\s+\\d+))?\\s*$",
          "flags": "i"
        }
      ],
      "nonNumericRowBounds": [],
      "confirmForms": [
        [
          "REPLACE"
        ],
        [
          "INSERT",
          "OVERWRITE"
        ],
        [
          "CREATE",
          "OR",
          "REPLACE",
          "TABLE"
        ],
        [
          "CREATE",
          "OR",
          "REPLACE",
          "TEMPORARY",
          "TABLE"
        ]
      ],
      "confirmCodeForms": [
        [
          "ON",
          "DUPLICATE",
          "KEY",
          "UPDATE"
        ],
        [
          "REPLACE",
          "INTO",
          "TABLE"
        ]
      ],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "sql",
      "nameQuote": "`"
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": true,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  }

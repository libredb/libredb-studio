          },
          "uncountableType": null
        },
        "statistics": {
          "probe": "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'sqlite_stat1'",
          "build": "statisticsBuild",
          "limitNote": "This engine records no per-column distinct count or null fraction at all, so none is shown for any column here, and none can be obtained without reading the data."
        },

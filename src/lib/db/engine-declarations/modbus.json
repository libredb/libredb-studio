{
  "id": "modbus",
  "displayName": "Modbus",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "registerMap"
    ],
    "defaults": {
      "port": 502
    },
    "seedOnly": {
      "fields": [
        "registerMap"
      ],
      "scope": "each",
      "refusal": "{field} is Modbus only: no other engine's provider reads it, so this connection would be listed as carrying it and would not. Remove {field} from this connection.",
      "projectionRefusal": null
    },
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": null,
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "registerMap",
          "text": "Register map"
        }
      ],
      "hints": [
        {
          "field": "host",
          "text": "The device enforces nothing of its own, so anything else that reaches its port can write to it. Protection is MODBUS/TCP Security or a network path you control."
        },
        {
          "field": "registerMap",
          "text": "A JSON array of points, each naming a unit, a table, a zero-based PDU address and a type. Without it a connection can still read a range by address, but no point has a name. Vendor documentation often counts addresses from one; these are the addresses that go on the wire."
        }
      ],
      "placeholders": [
        {
          "field": "registerMap",
          "text": "[{ \"name\": \"volts\", \"unitId\": 1, \"table\": \"holding_register\", \"address\": 100, \"type\": \"uint16\" }]"
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": []
  },
  "facets": {
    "monitoring": {
      "overview": "not-offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": [
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "modbusread"
  }
}

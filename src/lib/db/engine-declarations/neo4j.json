{
  "id": "neo4j",
  "displayName": "Neo4j",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database"
    ],
    "defaults": {
      "port": 7687
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [],
      "hints": [
        {
          "field": "database",
          "text": "Leave empty to use the server's home database."
        }
      ],
      "placeholders": [],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": []
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": [
      "sessions",
      "table-stats",
      "index-stats",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "cypher"
  }
}

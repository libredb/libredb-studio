  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "mtconnectread"
    ],
    "explainFormat": null,
    "dialect": {
      "name": "mtconnect",
      "offersColumnProfiling": false,

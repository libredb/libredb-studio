{
  "id": "db2",
  "displayName": "Db2 LUW",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database",
      "allowInsecureAuth"
    ],
    "defaults": {
      "port": 50000
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": true,
      "dialogOffersUri": false,
      "scheme": "db2",
      "urlTls": "urlTls",
      "paste": {
        "reader": "pasteReader",
        "catchAll": false,
        "formats": [
          "db2://"
        ]
      },
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],

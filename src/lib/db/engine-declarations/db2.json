{
  "id": "db2",
  "displayName": "Db2 LUW",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database",
      "allowInsecureAuth"
    ],
    "defaults": {
      "port": 50000
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": true,
      "dialogOffersUri": false,
      "scheme": "db2",
      "urlTls": "urlTls",
      "paste": {
        "reader": "pasteReader",
        "catchAll": false,
        "formats": [
          "db2://"
        ]
      },
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [],
      "hints": [
        {
          "field": "allowInsecureAuth",
          "text": "With no SSL mode this driver sends the password in cleartext, so the connection is refused unless this is ticked. Choose an SSL mode under SSL / TLS instead wherever the server offers one."
        }
      ],
      "placeholders": [],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [
      "analyze",
      "optimize"
    ],
    "agentReadings": [
      "table-stats",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [],
    "explainFormat": null,
    "dialect": null
  },
  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "code",
      "bracket": "quoted-identifier",
      "blockComment": "nesting",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [],
      "nonNumericRowBounds": [],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "sql",
      "nameQuote": null
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  }

{
  "id": "prometheus",
  "displayName": "Prometheus",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password"
    ],
    "defaults": {
      "port": 9090
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "user",
          "text": "User"
        },
        {
          "field": "password",
          "text": "Password or token"
        }
      ],
      "hints": [
        {
          "field": "password",
          "text": "Leave User empty to send this as a bearer token."
        }
      ],
      "placeholders": [],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "offered",
      "indexes": "not-offered",
      "storage": "offered"
    },
    "maintenance": [],
    "agentReadings": [
      "table-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "promql"
  }
}

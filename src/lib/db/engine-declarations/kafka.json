{
  "id": "kafka",
  "displayName": "Apache Kafka",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "saslMechanism",
      "user",
      "password"
    ],
    "defaults": {
      "port": 9092
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": false,
      "refusal": "Kafka does not run through an SSH tunnel: the tunnel forwards one address, and a Kafka client reads from every broker the cluster advertises, at the address the broker advertises. Connect to the brokers directly."
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "saslMechanism",
          "text": "SASL mechanism"
        }
      ],
      "hints": [
        {
          "field": "saslMechanism",
          "text": "PLAIN and SCRAM require TLS"
        }
      ],
      "placeholders": [],
      "placement": [],
      "options": [
        {
          "field": "saslMechanism",
          "choices": [
            {
              "value": "PLAIN",
              "label": "PLAIN"
            },
            {
              "value": "SCRAM-SHA-256",
              "label": "SCRAM-SHA-256"
            },
            {
              "value": "SCRAM-SHA-512",
              "label": "SCRAM-SHA-512"
            }
          ]
        }
      ],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "offered"
    },
    "maintenance": [],
    "agentReadings": [
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "kafkaread"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "kafkaread"
    ],
    "explainFormat": null,
    "dialect": {

{
  "id": "weaviate",
  "displayName": "Weaviate",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "password"
    ],
    "defaults": {
      "port": 8080
    },
    "seedOnly": null,
    "refused": [
      {
        "field": "user",
        "refusal": "Weaviate takes no user name: clear the connection's user, and put the API key or OIDC access token in the password. Nothing was sent."
      }
    ],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "secret",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "password",
          "text": "API key or token"
        }
      ],
      "hints": [
        {
          "field": "host",
          "text": "A name or address, or a pasted http:// or https:// address such as a Weaviate Cloud endpoint, which is split into Host and Port. Studio dials this port only, never Weaviate's gRPC port 50051."
        },
        {
          "field": "password",
          "text": "Weaviate receives the API key or OIDC access token on every request, so a key needs an SSL mode other than disable, unless the host is this machine or an SSH tunnel carries the connection. A key for a user with only the viewer role is the safest choice."
        }
      ],
      "placeholders": [],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [
      "http",
      "https"
    ],
    "credentialWarnings": [
      {
        "kind": "no-secret",
        "message": "A Weaviate server with anonymous access on, its default, answers a request that carries no key and grants it every write, so a read-only seed without a key promises a boundary the server does not keep."
      }
    ],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": [
      "table-stats",
      "index-stats",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "weaviateapi"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "weaviateapi"
    ],
    "explainFormat": null,
    "dialect": {
      "name": "weaviate",
      "offersColumnProfiling": false,
      "offersCodeGeneration": false,
      "offersCountQuery": false,
      "offersSqlExport": false,
      "historyMask": null
    }
  },
  "sqlText": {
    "readsSqlText": false,
    "grammar": {
      "hash": "comment-unless-operator",
      "bracket": "quoted-identifier",
      "blockComment": "flat",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [],
      "nonNumericRowBounds": [],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "none"
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  }
}

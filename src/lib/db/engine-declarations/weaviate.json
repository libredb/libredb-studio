{
  "id": "weaviate",
  "displayName": "Weaviate",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "password"
    ],
    "defaults": {
      "port": 8080
    },
    "seedOnly": null,
    "refused": [
      {
        "field": "user",
        "refusal": "Weaviate takes no user name: clear the connection's user, and put the API key or OIDC access token in the password. Nothing was sent."
      }
    ],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "secret",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "password",
          "text": "API key or token"
        }
      ],
      "hints": [
        {
          "field": "host",
          "text": "A name or address, or a pasted http:// or https:// address such as a Weaviate Cloud endpoint, which is split into Host and Port. Studio dials this port only, never Weaviate's gRPC port 50051."
        },
        {
          "field": "password",
          "text": "Weaviate receives the API key or OIDC access token on every request, so a key needs an SSL mode other than disable, unless the host is this machine or an SSH tunnel carries the connection. A key for a user with only the viewer role is the safest choice."
        }
      ],
      "placeholders": [],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [
      "http",
      "https"
    ],
    "credentialWarnings": [
      {
        "kind": "no-secret",
        "message": "A Weaviate server with anonymous access on, its default, answers a request that carries no key and grants it every write, so a read-only seed without a key promises a boundary the server does not keep."
      }
    ],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": [
      "table-stats",
      "index-stats",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "weaviateapi"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "weaviateapi"
    ],
    "explainFormat": null,
    "dialect": {
      "name": "weaviate",
      "offersColumnProfiling": false,
      "offersCodeGeneration": false,
      "offersCountQuery": false,
      "offersSqlExport": false,
      "historyMask": null
    },
    "language": {
      "queryLanguage": "json",
      "monacoId": "weaviate",
      "accent": "border-hue-lime-alt/40",
      "console": true
    }
  },
  "sqlText": {
    "readsSqlText": false,
    "grammar": {
      "hash": "comment-unless-operator",
      "bracket": "quoted-identifier",
      "blockComment": "flat",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [],
      "nonNumericRowBounds": [],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "none"
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  },
  "sqlWriting": {
    "escapeLiteral": "escapeLiteral",
    "unescapeLiteral": "unescapeLiteral",
    "quoteIdentifier": "quoteIdentifier",
    "placeholder": null,
    "temporalLiteral": null,
    "inlineEdit": {
      "instantTypeNames": [
        "date",
        "date32",
        "datetime",
        "datetime2",
        "datetime64",
        "datetimeoffset",
        "smalldatetime",
        "timestamp",
        "timestamptz"
      ],
      "exactDecimalTypeNames": [
        "number",
        "numeric",
        "decimal",
        "dec",
        "money",
        "smallmoney"
      ],
      "float64TypeNames": [
        "double",
        "float8",
        "float64",
        "binary_double"
      ],
      "boundEdit": null
    },
    "export": {
      "ddlTypes": {
        "text": "TEXT",
        "integer": "BIGINT",
        "numeric": "DOUBLE PRECISION",
        "boolean": "BOOLEAN",
        "timestamp": "TIMESTAMP",
        "binary": "BLOB"
      },
      "standsAlone": [],
      "bareSpelling": [],
      "typeVocabulary": {
        "bareTypeFamily": {
          "text": [
            "character varying",
            "varchar",
            "varchar2",
            "nvarchar",
            "nvarchar2",
            "character",
            "char",
            "nchar",
            "text",
            "ntext",
            "tinytext",
            "mediumtext",
            "longtext",
            "clob",
            "nclob",
            "enum",
            "set",
            "uniqueidentifier",
            "rowid"
          ],
          "integer": [
            "year"
          ],
          "numeric": [
            "numeric",
            "decimal",
            "number",
            "binary_double",
            "binary_float",
            "money"
          ],
          "boolean": [],
          "timestamp": [
            "timestamp",
            "timestamp without time zone",
            "timestamp with time zone",
            "datetime",
            "datetime2",
            "smalldatetime",
            "datetimeoffset"
          ],
          "binary": [
            "binary",
            "varbinary",
            "raw",
            "blob",
            "tinyblob",
            "mediumblob",
            "longblob",
            "bytea",
            "image"
          ]
        },
        "floatType": {
          "source": "^(double( precision)?|real|float\\d*|binary_(double|float))$",
          "flags": "i"
        },
        "exactNumericType": {
          "source": "^(numeric|decimal|number|decfloat)(\\s*\\(\\s*\\d+\\s*(,\\s*-?\\d+\\s*)?\\))?$",
          "flags": "i"
        },
        "numericWrapper": {
          "source": "^\\s*(?:Nullable|LowCardinality)\\((.*)\\)\\s*$",
          "flags": ""
        }
      },
      "binaryLiteral": "binaryLiteral",
      "nonFinite": {
        "NaN": "NULL",
        "Infinity": "NULL",
        "-Infinity": "NULL"
      },
      "insertForm": "values",
      "rewriteDeclared": null,
      "declareFromSample": null,
      "typedLiteral": null,
      "columnWriters": null,
      "createTableKey": null
    },
    "insertDocuments": null
  },
  "migrationDdl": {
    "tableDdl": "refused",
    "refusal": "-- Weaviate: Cannot generate table DDL. A collection's properties and vectors are declared through Weaviate's own schema API, not SQL DDL, so there is no column definition to change.",
    "transactionWrapper": null,
    "reasons": [
      "A collection's properties and vectors are declared through Weaviate's own schema API, not SQL DDL, so there is no column definition to change."
    ]
  },
  "sqlGenerators": null
}

        "boolean": "BOOLEAN",
        "timestamp": "TIMESTAMP",
        "binary": "BINARY"
      },
      "standsAlone": [
        "varchar",
        "timestamp",
        "binary"
      ],
      "bareSpelling": [],
      "typeVocabulary": {
        "bareTypeFamily": {
          "text": [
            "character varying",
            "varchar",
            "varchar2",
            "nvarchar",
            "nvarchar2",
            "character",
            "char",
            "nchar",

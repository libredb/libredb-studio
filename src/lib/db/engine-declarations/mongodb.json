{
  "id": "mongodb",
  "displayName": "MongoDB",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database",
      "connectionString",
      "authSource"
    ],
    "defaults": {
      "port": 27017
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": true,
      "dialogOffersUri": true,
      "scheme": "mongodb",
      "urlTls": null,
      "paste": {
        "reader": "pasteReader",
        "catchAll": false,
        "formats": [
          "mongodb://"
        ]
      },
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [],
      "hints": [
        {
          "field": "authSource",
          "text": "The database the user was created in, usually admin. Leave empty when the credentials live in the database above."
        }
      ],
      "placeholders": [
        {
          "field": "connectionString",
          "text": "mongodb://localhost:27017/mydb  or  mongodb+srv://..."
        }
      ],
      "placement": [
        {
          "field": "authSource",
          "where": "open"
        }
      ],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "offered",
      "storage": "offered"
    },
    "maintenance": [
      "vacuum",
      "analyze",
      "check",
      "kill"
    ],
    "agentReadings": [
      "sessions",
      "slow-queries",
      "table-stats",
      "index-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "mongo"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "mongo"
    ],
    "explainFormat": null,
    "dialect": null
  }
}

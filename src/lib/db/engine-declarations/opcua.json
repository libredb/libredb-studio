{
  "id": "opcua",
  "displayName": "OPC UA",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "user",
      "password",
      "securityMode",
      "serverCertificateThumbprint"
    ],
    "defaults": {
      "port": 4840
    },
    "seedOnly": {
      "fields": [
        "securityMode",
        "serverCertificateThumbprint",
        "securityPolicyUri",
        "clientCertificatePath",
        "clientPrivateKeyPath",
        "agentReadRoots"
      ],
      "scope": "each",
      "refusal": "{field} is OPC UA only: no other engine's provider reads it, so this connection would be listed as carrying it and would not. Remove {field} from this connection.",
      "projectionRefusal": null
    },
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": "seedCheck"
    },
    "tls": "not-offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [
      "clientCertificatePath",
      "clientPrivateKeyPath"
    ],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "host",
          "text": "Endpoint URL"
        },
        {
          "field": "user",
          "text": "Username"
        },
        {
          "field": "password",
          "text": "Password"
        },
        {
          "field": "securityMode",
          "text": "Security mode"
        },
        {
          "field": "serverCertificateThumbprint",
          "text": "Server certificate"
        }
      ],
      "hints": [
        {
          "field": "host",
          "text": "The endpoint exactly as you type it. This is the only address dialled: a server may advertise another, and OPC PLC advertises its own container name, which resolves nowhere."
        },
        {
          "field": "user",
          "text": "A server username, if the server checks one; empty for an anonymous session."
        },
        {
          "field": "password",
          "text": "The password for that username. On a server whose UserName token declares its own policy the password is encrypted even in None mode; where it declares none, a password to a host that is not this machine is refused unless an SSH tunnel carries it."
        },
        {
          "field": "securityMode",
          "text": "None, Sign or SignAndEncrypt. None encrypts nothing and authenticates nobody, so a certificate cannot be pinned there and this connection refuses the pair rather than checking a thumbprint it read over a channel nobody authenticated. There is no fallback: a mode the server does not offer is refused rather than quietly weakened. A secured mode also needs TRUST both ways on the first connect: the server's certificate has to be moved into trusted/certs under the PKI directory, and the server has to accept this client's - until then a secured connect is refused, and the refusal names the directory."
        },
        {
          "field": "serverCertificateThumbprint",
          "text": "The SHA-256 thumbprint this server's certificate must present, as 64 hexadecimal characters; colons and spaces are ignored. Without it any certificate the trust list accepts is accepted."
        }
      ],
      "placeholders": [
        {
          "field": "host",
          "text": "opc.tcp://plc.example.net:4840/"
        },
        {
          "field": "securityMode",
          "text": "SignAndEncrypt"
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": []
  },
  "agent": {
    "statementLanguage": "opcuaread"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "opcuaread"
    ],
    "explainFormat": null,
    "dialect": {
      "name": "opcua",
      "offersColumnProfiling": false,
      "offersCodeGeneration": false,
      "offersCountQuery": false,
      "offersSqlExport": true,
      "historyMask": null
    }
  },
  "sqlText": {
    "readsSqlText": false,
    "grammar": {
      "hash": "comment-unless-operator",
      "bracket": "quoted-identifier",
      "blockComment": "flat",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [],
      "nonNumericRowBounds": [],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "none"
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  }
}

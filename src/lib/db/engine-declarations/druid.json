{
  "id": "druid",
  "displayName": "Apache Druid",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password"
    ],
    "defaults": {
      "port": 8888
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    }
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "not-offered",
      "storage": "offered"
    },
    "maintenance": [],
    "agentReadings": [
      "sessions",
      "table-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  }
}

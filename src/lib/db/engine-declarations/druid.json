{
  "id": "druid",
  "displayName": "Apache Druid",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password"
    ],
    "defaults": {
      "port": 8888
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": "offered",
    "sshTunnel": {
      "offered": true
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [],
      "hints": [],
      "placeholders": [],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "not-offered",
      "storage": "offered"
    },
    "maintenance": [],
    "agentReadings": [
      "sessions",
      "table-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [],
    "explainFormat": "druid-native",
    "dialect": null
  },
  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "code",
      "bracket": "subscript",
      "blockComment": "flat",
      "alternateQuoting": false,
      "doubleSlashComment": true,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": false,
      "doubleQuoteBackslashEscapes": false,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": true,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": true,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [
        {
          "source": "\\s+ROWS?\\s*$",
          "flags": "i"
        }
      ],
      "nonNumericRowBounds": [
        "ALL"
      ],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "none"
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  }
}

{
  "id": "firestore",
  "displayName": "Firestore",
  "location": "external",
  "connection": {
    "fields": [
      "database",
      "schema",
      "password"
    ],
    "defaults": {},
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": "not-offered",
    "sshTunnel": {
      "offered": false,
      "refusal": "Firestore does not run through an SSH tunnel: every request goes over TLS to Google's API hosts, and a tunnel forwards one address of the several the provider reaches. Turn the tunnel off."
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": null,
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "database",
          "text": "Project ID"
        },
        {
          "field": "schema",
          "text": "Database ID"
        },
        {
          "field": "password",
          "text": "Service-account key, ADC JSON or access token"
        }
      ],
      "hints": [
        {
          "field": "database",
          "text": "The Google Cloud project that holds the database: 6 to 30 lowercase letters, digits and hyphens, starting with a letter. A legacy project id may carry a domain: prefix."
        },
        {
          "field": "schema",
          "text": "Empty for the (default) database. A named database's id is 4 to 63 lowercase letters, digits and hyphens, starting with a letter."
        },
        {
          "field": "password",
          "text": "Studio reads as this credential's IAM identity, and Firebase Security Rules do not apply to it. Grant a dedicated service account roles/datastore.viewer and paste its key. Every read Studio sends is billed to the project; docs/providers/firestore.md lists what each action reads. A pasted access token lasts about an hour. Leave this empty on an emulator server, or for an operator-seeded connection that uses the server's own identity."
        }
      ],
      "placeholders": [
        {
          "field": "database",
          "text": "my-project"
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "not-offered",
      "slowQueries": "not-offered",
      "activeSessions": "not-offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "agentReadings": [
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "fsquery"
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [
      "fsquery"
    ],
    "explainFormat": "firestore-explain",
    "dialect": {
      "name": "firestore",
      "offersColumnProfiling": false,
      "offersCodeGeneration": false,
      "offersCountQuery": true,
      "offersSqlExport": false,
      "historyMask": null
    },
    "language": {
      "queryLanguage": "json",
      "monacoId": "firestore",
      "accent": "border-hue-pink-alt/40",
      "console": false
    }
  },
  "sqlText": {
    "readsSqlText": false,
    "grammar": {
      "hash": "comment-unless-operator",
      "bracket": "quoted-identifier",
      "blockComment": "flat",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [],
      "nonNumericRowBounds": [],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "none"
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  },
  "sqlWriting": {
    "escapeLiteral": "escapeLiteral",
    "unescapeLiteral": "unescapeLiteral",
    "quoteIdentifier": "quoteIdentifier",
    "placeholder": null,
    "temporalLiteral": null,
    "inlineEdit": {
      "instantTypeNames": [
        "date",
        "date32",
        "datetime",
        "datetime2",
        "datetime64",
        "datetimeoffset",
        "smalldatetime",
        "timestamp",
        "timestamptz"
      ],
      "exactDecimalTypeNames": [
        "number",
        "numeric",
        "decimal",
        "dec",
        "money",
        "smallmoney"
      ],
      "float64TypeNames": [
        "double",
        "float8",
        "float64",
        "binary_double"
      ],
      "boundEdit": null
    },
    "export": {
      "ddlTypes": {
        "text": "TEXT",
        "integer": "BIGINT",
        "numeric": "DOUBLE PRECISION",
        "boolean": "BOOLEAN",
        "timestamp": "TIMESTAMP",
        "binary": "BLOB"
      },
      "standsAlone": [],
      "bareSpelling": [],
      "typeVocabulary": {
        "bareTypeFamily": {
          "text": [
            "character varying",
            "varchar",
            "varchar2",
            "nvarchar",
            "nvarchar2",
            "character",
            "char",
            "nchar",
            "text",
            "ntext",
            "tinytext",
            "mediumtext",
            "longtext",
            "clob",
            "nclob",
            "enum",
            "set",
            "uniqueidentifier",
            "rowid"
          ],
          "integer": [
            "year"
          ],
          "numeric": [
            "numeric",
            "decimal",
            "number",
            "binary_double",
            "binary_float",
            "money"
          ],
          "boolean": [],
          "timestamp": [
            "timestamp",
            "timestamp without time zone",
            "timestamp with time zone",
            "datetime",
            "datetime2",
            "smalldatetime",
            "datetimeoffset"
          ],
          "binary": [
            "binary",
            "varbinary",
            "raw",
            "blob",
            "tinyblob",
            "mediumblob",
            "longblob",
            "bytea",
            "image"
          ]
        },
        "floatType": {
          "source": "^(double( precision)?|real|float\\d*|binary_(double|float))$",
          "flags": "i"
        },
        "exactNumericType": {
          "source": "^(numeric|decimal|number|decfloat)(\\s*\\(\\s*\\d+\\s*(,\\s*-?\\d+\\s*)?\\))?$",
          "flags": "i"
        },
        "numericWrapper": {
          "source": "^\\s*(?:Nullable|LowCardinality)\\((.*)\\)\\s*$",
          "flags": ""
        }
      },
      "binaryLiteral": "binaryLiteral",
      "nonFinite": {
        "NaN": "NULL",
        "Infinity": "NULL",
        "-Infinity": "NULL"
      },
      "insertForm": "values",
      "rewriteDeclared": null,
      "declareFromSample": null,
      "typedLiteral": null,
      "columnWriters": null,
      "createTableKey": null
    },
    "insertDocuments": null
  },
  "migrationDdl": {
    "tableDdl": "refused",
    "refusal": "-- Firestore: Cannot generate table DDL. A document store keeps no schema, so there is no column definition to change.",
    "transactionWrapper": null,
    "reasons": [
      "A document store keeps no schema, so there is no column definition to change."
    ]
  },
  "sqlGenerators": null
}

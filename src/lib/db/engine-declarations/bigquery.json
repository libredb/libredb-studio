{
  "id": "bigquery",
  "displayName": "BigQuery",
  "location": "external",
  "connection": {
    "fields": [
      "database",
      "schema",
      "password",
      "location"
    ],
    "defaults": {},
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false
    },
    "tls": "not-offered",
    "sshTunnel": {
      "offered": false,
      "refusal": "BigQuery does not run through an SSH tunnel: every request goes over HTTPS to Google's API hosts, and a tunnel forwards one address of the several the provider reaches. Turn the tunnel off."
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "secret",
      "supersededBy": []
    },
    "dialog": {
      "order": [
        "password",
        "database",
        "location",
        "schema"
      ],
      "labels": [
        {
          "field": "database",
          "text": "Project ID"
        },
        {
          "field": "schema",
          "text": "Default dataset"
        },
        {
          "field": "password",
          "text": "Service-account key JSON or access token"
        },
        {
          "field": "location",
          "text": "Location"
        }
      ],
      "hints": [
        {
          "field": "password",
          "text": "The whole key file's JSON, or a bearer token. Empty uses the server's own credentials, where the deployment enables them."
        }
      ],
      "placeholders": [
        {
          "field": "database",
          "text": "my-gcp-project"
        },
        {
          "field": "password",
          "text": "key JSON, a ya29… token, or empty"
        },
        {
          "field": "location",
          "text": "detected (e.g. EU, US, europe-west3)"
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "not-offered",
      "storage": "offered"
    },
    "maintenance": [],
    "agentReadings": [
      "sessions",
      "slow-queries",
      "table-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": null
  }
}

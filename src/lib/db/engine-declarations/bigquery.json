{
  "id": "bigquery",
  "displayName": "BigQuery",
  "location": "external",
  "connection": {
    "fields": [
      "database",
      "schema",
      "password",
      "location"
    ],
    "defaults": {},
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": {
      "modes": []
    },
    "readsTrustMaterial": false,
    "sshTunnel": {
      "offered": false,
      "refusal": "BigQuery does not run through an SSH tunnel: every request goes over HTTPS to Google's API hosts, and a tunnel forwards one address of the several the provider reaches. Turn the tunnel off."
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "secret",
      "supersededBy": []
    },
    "dialog": {
      "order": [
        "password",
        "database",
        "location",
        "schema"
      ],
      "labels": [
        {
          "field": "database",
          "text": "Project ID"
        },
        {
          "field": "schema",
          "text": "Default dataset"
        },
        {
          "field": "password",
          "text": "Service-account key JSON or access token"
        },
        {
          "field": "location",
          "text": "Location"
        }
      ],
      "hints": [
        {
          "field": "password",
          "text": "The whole key file's JSON, or a bearer token. Empty uses the server's own credentials, where the deployment enables them."
        }
      ],
      "placeholders": [
        {
          "field": "database",
          "text": "my-gcp-project"
        },
        {
          "field": "password",
          "text": "key JSON, a ya29… token, or empty"
        },
        {
          "field": "location",
          "text": "detected (e.g. EU, US, europe-west3)"
        }
      ],
      "placement": [],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null,
    "connectBudgetMs": 140000
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "not-offered",
      "storage": "offered"
    },
    "maintenance": [],
    "maintenanceSpecs": [],
    "agentReadings": [
      "sessions",
      "slow-queries",
      "table-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": null,
    "overlay": null
  },
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [],
    "explainFormat": "bigquery-dryrun",
    "dialect": null,
    "language": {
      "queryLanguage": "sql",
      "monacoId": "sql",
      "accent": "border-hue-blue/40",
      "console": false
    }
  },
  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "comment",
      "bracket": "subscript",
      "blockComment": "flat",
      "alternateQuoting": false,
      "doubleSlashComment": false,
      "backslashAlwaysEscapes": true,
      "tripleQuotedStrings": true,
      "backtickBackslashEscapes": true,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": false,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [],
      "nonNumericRowBounds": [],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "sql",
      "nameQuote": null
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  },
  "sqlWriting": {
    "escapeLiteral": "escapeLiteral",
    "unescapeLiteral": "unescapeLiteral",
    "quoteIdentifier": "quoteIdentifier",
    "placeholder": null,
    "temporalLiteral": null,
    "inlineEdit": {
      "instantTypeNames": [
        "date",
        "date32",
        "datetime",
        "datetime2",
        "datetime64",
        "datetimeoffset",
        "smalldatetime",
        "timestamp",
        "timestamptz"
      ],
      "exactDecimalTypeNames": [
        "number",
        "numeric",
        "decimal",
        "dec",
        "money",
        "smallmoney"
      ],
      "float64TypeNames": [
        "double",
        "float8",
        "float64",
        "binary_double"
      ],
      "boundEdit": null
    },
    "export": {
      "ddlTypes": {
        "text": "TEXT",
        "integer": "BIGINT",
        "numeric": "DOUBLE PRECISION",
        "boolean": "BOOLEAN",
        "timestamp": "TIMESTAMP",
        "binary": "BLOB"
      },
      "standsAlone": [],
      "bareSpelling": [],
      "typeVocabulary": {
        "bareTypeFamily": {
          "text": [
            "character varying",
            "varchar",
            "varchar2",
            "nvarchar",
            "nvarchar2",
            "character",
            "char",
            "nchar",
            "text",
            "ntext",
            "tinytext",
            "mediumtext",
            "longtext",
            "clob",
            "nclob",
            "enum",
            "set",
            "uniqueidentifier",
            "rowid"
          ],
          "integer": [
            "year"
          ],
          "numeric": [
            "numeric",
            "decimal",
            "number",
            "binary_double",
            "binary_float",
            "money"
          ],
          "boolean": [],
          "timestamp": [
            "timestamp",
            "timestamp without time zone",
            "timestamp with time zone",
            "datetime",
            "datetime2",
            "smalldatetime",
            "datetimeoffset"
          ],
          "binary": [
            "binary",
            "varbinary",
            "raw",
            "blob",
            "tinyblob",
            "mediumblob",
            "longblob",
            "bytea",
            "image"
          ]
        },
        "floatType": {
          "source": "^(double( precision)?|real|float\\d*|binary_(double|float))$",
          "flags": "i"
        },
        "exactNumericType": {
          "source": "^(numeric|decimal|number|decfloat)(\\s*\\(\\s*\\d+\\s*(,\\s*-?\\d+\\s*)?\\))?$",
          "flags": "i"
        },
        "numericWrapper": {
          "source": "^\\s*(?:Nullable|LowCardinality)\\((.*)\\)\\s*$",
          "flags": ""
        }
      },
      "binaryLiteral": "binaryLiteral",
      "nonFinite": {
        "NaN": "NULL",
        "Infinity": "NULL",
        "-Infinity": "NULL"
      },
      "insertForm": "values",
      "rewriteDeclared": null,
      "declareFromSample": null,
      "typedLiteral": null,
      "columnWriters": null,
      "createTableKey": null
    },
    "insertDocuments": null
  },
  "migrationDdl": {
    "tableDdl": "written",
    "transactionWrapper": null,
    "createTable": {
      "kind": "written",
      "primaryKey": "createTablePrimaryKey",
      "foreignKey": "createTableForeignKey"
    },
    "columnDef": "columnDef",
    "createIndex": "createIndex",
    "dropIndex": "dropIndex",
    "addForeignKey": "addForeignKey",
    "dropForeignKey": "dropForeignKey",
    "addColumn": "addColumn",
    "dropColumn": "dropColumn",
    "modifyColumn": "modifyColumn",
    "dropTable": "dropTable",
    "reasons": [
      "BigQuery widens a column with ALTER COLUMN ... SET DATA TYPE only along its coercion rules, and nothing else; write the change by hand.",
      "BigQuery: Cannot generate index DDL. BigQuery has search and vector indexes only; write the index change by hand.",
      "The engine has no foreign-key constraint.",
      "BigQuery accepts a primary key only as PRIMARY KEY (...) NOT ENFORCED."
    ]
  },
  "sqlGenerators": null,
  "policy": {
    "writeReach": "open",
    "readsFileAccessPosture": false,
    "deniedFileAccessRefusal": null,
    "singleWriterFile": false,
    "readRootsRequired": false,
    "agentCredentialForm": "service-account-key",
    "maskingExemptColumns": null
  },
  "mcp": {
    "exposable": true,
    "statementRead": false,
    "metadataReadChangesState": false,
    "agentCredentialRequired": false
  },
  "safeguards": {
    "writePaths": {
      "editor": {
        "reach": "open"
      },
      "objectEdit": {
        "reach": "open"
      },
      "maintenance": {
        "reach": "open"
      },
      "transaction": {
        "reach": "open"
      }
    },
    "metadataOnly": null,
    "inlineEditRefusedColumns": null
  }
}

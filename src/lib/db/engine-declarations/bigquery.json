{
  "id": "bigquery",
  "displayName": "BigQuery",
  "location": "external",
  "connection": {
    "fields": [
      "database",
      "schema",
      "password",
      "location"
    ],
    "defaults": {},
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false
    },
    "tls": "not-offered",
    "sshTunnel": {
      "offered": false,
      "refusal": "BigQuery does not run through an SSH tunnel: every request goes over HTTPS to Google's API hosts, and a tunnel forwards one address of the several the provider reaches. Turn the tunnel off."
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "secret",
      "supersededBy": []
    }
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "offered",
      "activeSessions": "offered",
      "tables": "offered",
      "indexes": "not-offered",
      "storage": "offered"
    },
    "maintenance": [],
    "agentReadings": [
      "sessions",
      "slow-queries",
      "table-stats",
      "storage",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": null
  }
}

{
  "id": "cassandra",
  "displayName": "Apache Cassandra",
  "location": "external",
  "connection": {
    "fields": [
      "host",
      "port",
      "user",
      "password",
      "database",
      "localDataCenter"
    ],
    "defaults": {
      "port": 9042
    },
    "seedOnly": null,
    "refused": [],
    "connectionString": {
      "accepted": false,
      "dialogOffersUri": false,
      "scheme": null,
      "urlTls": null,
      "paste": null,
      "seedCheck": null
    },
    "tls": {
      "modes": [
        "disable",
        "require",
        "verify-system",
        "verify-ca",
        "verify-full"
      ]
    },
    "readsTrustMaterial": false,
    "sshTunnel": {
      "offered": false,
      "refusal": "Apache Cassandra does not run through an SSH tunnel: the tunnel forwards one address, and the driver reaches every other node of the ring at the address that node advertises. Connect to the cluster directly, or turn the tunnel off."
    },
    "hostPathFields": [],
    "opensLocalFile": false,
    "serverLevelWithoutDatabase": false,
    "agentCredential": {
      "form": "pair",
      "supersededBy": []
    },
    "dialog": {
      "order": null,
      "labels": [
        {
          "field": "database",
          "text": "Keyspace Name"
        }
      ],
      "hints": [
        {
          "field": "database",
          "text": "The keyspace to open. Tables inside it are the level below; statements can still name any keyspace in full."
        },
        {
          "field": "localDataCenter",
          "text": "Required: the Cassandra driver refuses to connect without it. A stock single-node install reports datacenter1; the server lists the ones it has if this is wrong."
        }
      ],
      "placeholders": [
        {
          "field": "database",
          "text": "probe"
        }
      ],
      "placement": [
        {
          "field": "localDataCenter",
          "where": "open"
        }
      ],
      "options": [],
      "shownWhen": [],
      "absentValues": []
    },
    "hostUriSchemes": [],
    "credentialWarnings": [],
    "fieldRules": [],
    "hostHint": null,
    "hostIdentity": null,
    "import": null,
    "connectBudgetMs": null
  },
  "facets": {
    "monitoring": {
      "overview": "offered",
      "performance": "offered",
      "slowQueries": "not-offered",
      "activeSessions": "offered",
      "tables": "not-offered",
      "indexes": "not-offered",
      "storage": "not-offered"
    },
    "maintenance": [],
    "maintenanceSpecs": [],
    "agentReadings": [
      "sessions",
      "health"
    ]
  },
  "agent": {
    "statementLanguage": "sql",
    "overlay": {
      "dialect": {
        "catalogRead": {
          "compose": {
            "columns": "catalogColumns",
            "relations": "catalogRelations",
            "indexes": "catalogIndexes",
            "statistics": "catalogStatistics"
          },
          "declaredSchema": null,
          "retry": null,
          "commandShaped": false,
          "mapRows": null
        },
        "planEstimate": null,
        "profileComposition": null,
        "statistics": null,
        "catalogCapture": null
      },
      "grounding": "groundingOverride"
    }
  },
  "statementLanguageData": null,
  "editor": {
    "commitKeyword": "COMMIT",
    "consentDeadline": null,
    "fenceAliases": [],
    "explainFormat": null,
    "dialect": null,
    "language": {
      "queryLanguage": "sql",
      "monacoId": "sql",
      "accent": "border-hue-blue/40",
      "console": false
    }
  },
  "sqlText": {
    "readsSqlText": true,
    "grammar": {
      "hash": "code",
      "bracket": "subscript",
      "blockComment": "flat",
      "alternateQuoting": false,
      "doubleSlashComment": true,
      "backslashAlwaysEscapes": false,
      "tripleQuotedStrings": false,
      "backtickBackslashEscapes": false,
      "dollarTags": true,
      "doubleQuoteBackslashEscapes": null,
      "singleQuoteBackslashEscapes": null,
      "rawStrings": false,
      "hintsAreCode": false,
      "lineCommentBackslashContinues": false,
      "lineCommentEndsAtCarriageReturn": true,
      "script": {
        "blocks": "none",
        "separatorLine": null,
        "unit": "statement",
        "terminatedStatements": []
      },
      "trailingLimitClauses": [
        {
          "source": "\\s+ALLOW\\s+FILTERING\\s*$",
          "flags": "i"
        },
        {
          "source": "\\s+BYPASS\\s+CACHE\\s*$",
          "flags": "i"
        },
        {
          "source": "\\s+USING\\s+TIMEOUT\\s+[^()\\s]+\\s*$",
          "flags": "i"
        }
      ],
      "nonNumericRowBounds": [],
      "confirmForms": [],
      "confirmCodeForms": [],
      "confirmFormsWhen": [],
      "confirmExemptForms": [],
      "formatterLanguage": "postgresql",
      "completionWords": {
        "keywords": [],
        "functions": []
      },
      "confirmConfigKeys": null,
      "explainExecutesWithAnalyze": false
    },
    "redaction": {
      "kind": "sql",
      "nameQuote": null
    },
    "updateTarget": {
      "dashCommentNeedsSeparator": false,
      "extraQueryOpeners": [],
      "extraSetOperators": []
    },
    "completion": {
      "formatSegment": null,
      "readQuotedQualifier": null
    }
  },
  "sqlWriting": {
    "escapeLiteral": "escapeLiteral",
    "unescapeLiteral": "unescapeLiteral",
    "quoteIdentifier": "quoteIdentifier",
    "placeholder": null,
    "temporalLiteral": null,
    "inlineEdit": {
      "instantTypeNames": [
        "date",
        "date32",
        "datetime",
        "datetime2",
        "datetime64",
        "datetimeoffset",
        "smalldatetime",
        "timestamp",
        "timestamptz"
      ],
      "exactDecimalTypeNames": [
        "number",
        "numeric",
        "decimal",
        "dec",
        "money",
        "smallmoney"
      ],
      "float64TypeNames": [
        "double",
        "float8",
        "float64",
        "binary_double"
      ],
      "boundEdit": null
    },
    "export": {
      "ddlTypes": {
        "text": "TEXT",
        "integer": "BIGINT",
        "numeric": "DOUBLE",
        "boolean": "BOOLEAN",
        "timestamp": "TIMESTAMP",
        "binary": "BLOB"
      },
      "standsAlone": [
        "varchar",
        "text",
        "blob",
        "decimal",
        "timestamp"
      ],
      "bareSpelling": [],
      "typeVocabulary": {
        "bareTypeFamily": {
          "text": [
            "character varying",
            "varchar",
            "varchar2",
            "nvarchar",
            "nvarchar2",
            "character",
            "char",
            "nchar",
            "text",
            "ntext",
            "tinytext",
            "mediumtext",
            "longtext",
            "clob",
            "nclob",
            "enum",
            "set",
            "uniqueidentifier",
            "rowid"
          ],
          "integer": [
            "year"
          ],
          "numeric": [
            "numeric",
            "decimal",
            "number",
            "binary_double",
            "binary_float",
            "money"
          ],
          "boolean": [],
          "timestamp": [
            "timestamp",
            "timestamp without time zone",
            "timestamp with time zone",
            "datetime",
            "datetime2",
            "smalldatetime",
            "datetimeoffset"
          ],
          "binary": [
            "binary",
            "varbinary",
            "raw",
            "blob",
            "tinyblob",
            "mediumblob",
            "longblob",
            "bytea",
            "image"
          ]
        },
        "floatType": {
          "source": "^(double( precision)?|real|float\\d*|binary_(double|float))$",
          "flags": "i"
        },
        "exactNumericType": {
          "source": "^(numeric|decimal|number|decfloat)(\\s*\\(\\s*\\d+\\s*(,\\s*-?\\d+\\s*)?\\))?$",
          "flags": "i"
        },
        "numericWrapper": {
          "source": "^\\s*(?:Nullable|LowCardinality)\\((.*)\\)\\s*$",
          "flags": ""
        }
      },
      "binaryLiteral": "binaryLiteral",
      "nonFinite": {
        "NaN": "NULL",
        "Infinity": "NULL",
        "-Infinity": "NULL"
      },
      "insertForm": "values",
      "rewriteDeclared": "rewriteDeclared",
      "declareFromSample": null,
      "typedLiteral": "typedLiteral",
      "columnWriters": null,
      "createTableKey": {
        "note": "-- CQL requires exactly one PRIMARY KEY per table, and a result set carries no key of\n-- its own. This export chose the first column as a placeholder: confirm it is unique\n-- per row before running this statement.\n",
        "clause": "createTableKeyClause"
      }
    },
    "insertDocuments": null
  },
  "migrationDdl": {
    "tableDdl": "written",
    "transactionWrapper": null,
    "createTable": {
      "kind": "refused",
      "createTableRefusal": "createTableRefusal"
    },
    "columnDef": "columnDef",
    "createIndex": "createIndex",
    "dropIndex": "dropIndex",
    "addForeignKey": "addForeignKey",
    "dropForeignKey": "dropForeignKey",
    "addColumn": "addColumn",
    "dropColumn": "dropColumn",
    "modifyColumn": "modifyColumn",
    "dropTable": "dropTable",
    "reasons": [
      "A CQL primary key splits into a partition key and clustering columns, and a schema diff records neither role, so the partitioning cannot be derived; write the CREATE TABLE by hand.",
      "Cassandra no longer supports altering a column's type; add a new column and migrate the values, or recreate the table.",
      "The clause is not in CQL's grammar; enforce the relationship in the application.",
      "CQL never declared one."
    ]
  },
  "sqlGenerators": null,
  "policy": {
    "writeReach": "open",
    "readsFileAccessPosture": false,
    "deniedFileAccessRefusal": null,
    "singleWriterFile": false,
    "readRootsRequired": false,
    "agentCredentialForm": "pair",
    "maskingExemptColumns": null
  },
  "mcp": {
    "exposable": true,
    "statementRead": true,
    "metadataReadChangesState": false,
    "agentCredentialRequired": false
  },
  "safeguards": {
    "writePaths": {
      "editor": {
        "reach": "open"
      },
      "objectEdit": {
        "reach": "open"
      },
      "maintenance": {
        "reach": "open"
      },
      "transaction": {
        "reach": "open"
      }
    },
    "metadataOnly": null,
    "inlineEditRefusedColumns": null
  }
}

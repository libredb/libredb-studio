{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/exports/index.js",
        "src/components/ui/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "e2e/**/*.ts",
        "scripts/*.mjs",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "e2e/**/*.ts",
        "scripts/*.mjs",
        "scripts/*.ts"
      ]
    },
    "vscode-extension": {
      "entry": [
        ".vscode-test.mjs",
        "scripts/*.mjs",
        "test/**/*.test.{ts,tsx}",
        "test/browser/**/*.spec.ts",
        "test/setup/*"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "scripts/*.mjs",
        "scripts/*.tsx"
      ],
      "playwright": false,
      "ignoreDependencies": [
        "get-nonce",
        "@radix-ui/react-use-layout-effect",
        "sharp"
      ]
    }
  },
  "ignoreDependencies": [
    "tailwindcss",
    "@workflow/world-postgres",
    "@ai-sdk/anthropic",
    "ajv"
  ],
  "ignoreBinaries": [
    "genhtml",
    "java",
    "kubectl",
    "openssl",
    "ss"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": [
    "-lintignore"
  ]
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/exports/index.js",
    "src/components/ui/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/*.mjs",
    "scripts/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/*.mjs",
    "scripts/*.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "@workflow/world-postgres",
    "@ai-sdk/anthropic",
    "ajv"
  ],
  "ignoreBinaries": [
    "genhtml",
    "java",
    "openssl",
    "ss"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": [
    "-lintignore"
  ]
}
